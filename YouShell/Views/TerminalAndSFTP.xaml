<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="YouShell.Views.TerminalAndSFTP"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:term="using:YouShell.Terminal"
    FontFamily="Microsoft YaHei">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 终端 -->
        <term:TerminalControl x:Name="Terminal" Grid.Row="0" Margin="8" Loaded="Terminal_Loaded" />

        <!-- SFTP -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 工具栏 -->
            <Border Grid.Row="0" Height="36" Padding="5">
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button x:Name="BtnBack" Click="BtnBack_Click" Width="28" Height="26" ToolTipService.ToolTip="后退">
                        <FontIcon Glyph="&#xE72B;" FontSize="13" />
                    </Button>
                    <Button x:Name="BtnForward" Click="BtnForward_Click" Width="28" Height="26" ToolTipService.ToolTip="前进">
                        <FontIcon Glyph="&#xE72A;" FontSize="13" />
                    </Button>
                    <Button x:Name="BtnRefresh" Click="BtnRefresh_Click" Width="28" Height="26" ToolTipService.ToolTip="刷新">
                        <FontIcon Glyph="&#xE72C;" FontSize="13" />
                    </Button>
                    <Button x:Name="BtnUp" Click="BtnUp_Click" Width="28" Height="26" ToolTipService.ToolTip="上级目录">
                        <FontIcon Glyph="&#xE74A;" FontSize="13" />
                    </Button>
                    <Button x:Name="BtnNewFolder" Click="BtnNewFolder_Click" Width="30" Height="26" ToolTipService.ToolTip="新建文件夹">
                        <FontIcon Glyph="&#xE8F4;" FontSize="13" Foreground="#00BCFF" />
                    </Button>

                    <TextBlock x:Name="TxtCurrentPath" Text="/" VerticalAlignment="Center" Margin="0,0,10,0" />

                    <DropDownButton x:Name="BtnUpload" Width="70" Height="26">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE898;" FontSize="13" Foreground="#00BCFF" />
                            <TextBlock Text="上传" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="上传文件" Click="CtxUploadFile_Click" />
                                <MenuFlyoutItem Text="上传文件夹" Click="CtxUploadFolder_Click" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <Button x:Name="BtnDownload" Click="BtnDownload_Click" Width="70" Height="26" ToolTipService.ToolTip="下载选中">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE896;" FontSize="13" Foreground="#4CAF50" />
                            <TextBlock Text="下载" />
                        </StackPanel>
                    </Button>

                    <FontIcon x:Name="TxtStatusIcon" Glyph="&#xE73E;" Foreground="LimeGreen" FontSize="16"
                              VerticalAlignment="Center" Margin="0,0,8,0" DoubleTapped="StatusIcon_DoubleTapped"
                              ToolTipService.ToolTip="当前没有传输任务" />

                    <Button x:Name="BtnSshTunnel" Click="BtnSshTunnel_Click" Width="32" Height="26" ToolTipService.ToolTip="SSH隧道管理">
                        <FontIcon Glyph="&#xE9D5;" FontSize="13" Foreground="#00BCFF" />
                    </Button>
                    <Button x:Name="BtnTraceroute" Click="BtnTraceroute_Click" Width="32" Height="26" ToolTipService.ToolTip="路由追踪">
                        <FontIcon Glyph="&#xE8CB;" FontSize="13" Foreground="#FF9800" />
                    </Button>
                    <Button x:Name="BtnSysManagement" Click="BtnSysManagement_Click" Width="32" Height="26" ToolTipService.ToolTip="系统管理">
                        <FontIcon Glyph="&#xE713;" FontSize="13" Foreground="#9C27B0" />
                    </Button>
                    <Button x:Name="BtnTermCopy" Click="BtnTermCopy_Click" Width="32" Height="26" ToolTipService.ToolTip="复制选中内容">
                        <FontIcon Glyph="&#xE8C8;" FontSize="13" Foreground="#AEB5BD" />
                    </Button>

                    <TextBlock x:Name="TxtConnStatus" Text="等待中..." VerticalAlignment="Center" FontSize="11" Margin="10,0,6,0" />
                    <TextBlock x:Name="TxtCursorMode" Text="NORMAL MODE" VerticalAlignment="Center" FontSize="11" Opacity="0.8" />
                </StackPanel>
            </Border>

            <!-- 文件列表 -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Padding="12,6" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="文件名" FontWeight="SemiBold" Foreground="#78909C" />
                    <TextBlock Grid.Column="1" Text="大小" FontWeight="SemiBold" Foreground="#78909C" />
                    <TextBlock Grid.Column="2" Text="类型" FontWeight="SemiBold" Foreground="#78909C" />
                    <TextBlock Grid.Column="3" Text="修改时间" FontWeight="SemiBold" Foreground="#78909C" />
                    <TextBlock Grid.Column="4" Text="权限" FontWeight="SemiBold" Foreground="#78909C" />
                    <TextBlock Grid.Column="5" Text="用户/用户组" FontWeight="SemiBold" Foreground="#78909C" />
                </Grid>

                <ListView
                    x:Name="FileGrid"
                    Grid.Row="1"
                    ItemsSource="{Binding Files}"
                    SelectionMode="Multiple"
                    AllowDrop="True"
                    DragOver="FileGrid_DragOver"
                    Drop="FileGrid_Drop"
                    DoubleTapped="FileGrid_DoubleTapped"
                    HorizontalContentAlignment="Stretch"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.HorizontalScrollMode="Enabled">
                    <ListView.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="使用 VS Code 编辑" Click="CtxGridEditVSCode_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE943;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="使用记事本编辑" Click="CtxGridEditNotepad_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE7C3;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="下载" Click="CtxGridDownload_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE896;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="删除" Click="CtxGridDelete_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74D;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="重命名" Click="CtxGridRename_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE70F;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="复制" Click="CtxGridCopy_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8C8;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="粘贴" Click="CtxGridPaste_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE77F;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </ListView.ContextFlyout>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="12,6" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="{Binding IsDirectory, Converter={StaticResource DirGlyph}}" FontSize="14" Foreground="#00BCFF" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Size}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Type}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding Date}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="{Binding Perms}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="5" Text="{Binding Owner}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

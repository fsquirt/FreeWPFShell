<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="YouShell.Views.TerminalAndSFTP"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:term="using:YouShell.Terminal"
    FontFamily="Microsoft YaHei">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 终端 -->
        <term:TerminalControl x:Name="Terminal" Grid.Row="0" Margin="8" Loaded="Terminal_Loaded" />

        <!-- 上排：监控文字 -->
        <Border Grid.Row="1" Height="24" Padding="8,0">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock x:Name="TxtHostIp" Text="IP --" FontSize="11" VerticalAlignment="Center" />
                <TextBlock x:Name="TxtUptime" Text="运行 -- 天..." FontSize="11" VerticalAlignment="Center" />
                <TextBlock x:Name="TxtPing" Text="--ms" FontSize="11" VerticalAlignment="Center" />
                <TextBlock x:Name="TxtCpu" Text="CPU 0.0%" FontSize="11" VerticalAlignment="Center" />
                <TextBlock x:Name="TxtMem" Text="内存 0.0%" FontSize="11" VerticalAlignment="Center" />
                <TextBlock x:Name="TxtSwap" Text="交换 0.0%" FontSize="11" VerticalAlignment="Center" />
                <TextBlock x:Name="TxtNetIface" Text="网卡 --" FontSize="11" VerticalAlignment="Center" />
                <TextBlock x:Name="TxtNetUp" Text="↑ 0K/s" FontSize="11" VerticalAlignment="Center" />
                <TextBlock x:Name="TxtNetDown" Text="↓ 0K/s" FontSize="11" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- 下排：按钮 -->
        <Border Grid.Row="2" Height="36" Padding="5">
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <TextBlock x:Name="TxtConnStatus" Text="等待中..." VerticalAlignment="Center" FontSize="11" Margin="0,0,10,0" />
                <TextBlock x:Name="TxtCursorMode" Text="NORMAL MODE" VerticalAlignment="Center" FontSize="11" Opacity="0.8" Margin="0,0,10,0" />

                <FontIcon x:Name="TxtStatusIcon" Glyph="&#xE73E;" Foreground="LimeGreen" FontSize="16"
                          VerticalAlignment="Center" Margin="0,0,10,0" DoubleTapped="StatusIcon_DoubleTapped"
                          ToolTipService.ToolTip="当前没有传输任务" />

                <Button x:Name="BtnSftpManager" Click="BtnSftpManager_Click" Height="30" Padding="10,0" ToolTipService.ToolTip="SFTP文件管理">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8B7;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="SFTP文件管理" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="BtnSshTunnel" Click="BtnSshTunnel_Click" Height="30" Padding="10,0" ToolTipService.ToolTip="SSH隧道管理">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE9D5;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="SSH隧道管理" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="BtnTraceroute" Click="BtnTraceroute_Click" Height="30" Padding="10,0" ToolTipService.ToolTip="路由追踪">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8CB;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="路由追踪" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="BtnSysManagement" Click="BtnSysManagement_Click" Height="30" Padding="10,0" ToolTipService.ToolTip="系统管理">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE713;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="系统管理" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="BtnTermCopy" Click="BtnTermCopy_Click" Height="30" Padding="10,0" ToolTipService.ToolTip="复制选中内容">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8C8;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="复制选中内容" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

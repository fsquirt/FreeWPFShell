<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="YouShell.Views.SftpPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FontFamily="Microsoft YaHei">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" Height="36" Padding="6,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button x:Name="BtnBack" Click="BtnBack_Click" Width="30" Height="30" Padding="0" ToolTipService.ToolTip="后退">
                        <FontIcon Glyph="&#xE72B;" FontSize="14" />
                    </Button>
                    <Button x:Name="BtnForward" Click="BtnForward_Click" Width="30" Height="30" Padding="0" ToolTipService.ToolTip="前进">
                        <FontIcon Glyph="&#xE72A;" FontSize="14" />
                    </Button>
                    <Button x:Name="BtnRefresh" Click="BtnRefresh_Click" Width="30" Height="30" Padding="0" ToolTipService.ToolTip="刷新">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    </Button>
                    <Button x:Name="BtnUp" Click="BtnUp_Click" Width="30" Height="30" Padding="0" ToolTipService.ToolTip="上级目录">
                        <FontIcon Glyph="&#xE74A;" FontSize="14" />
                    </Button>
                    <Button x:Name="BtnNewFolder" Click="BtnNewFolder_Click" Width="30" Height="30" Padding="0" ToolTipService.ToolTip="新建文件夹">
                        <FontIcon Glyph="&#xE8F4;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </Button>

                    <DropDownButton x:Name="BtnUpload" Height="30" Padding="10,0">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE898;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="上传" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="上传文件" Click="CtxUploadFile_Click" />
                                <MenuFlyoutItem Text="上传文件夹" Click="CtxUploadFolder_Click" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <Button x:Name="BtnDownload" Click="BtnDownload_Click" Height="30" Padding="10,0" ToolTipService.ToolTip="下载选中">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE896;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="下载" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnTasks" Click="BtnTasks_Click" Height="30" Padding="10,0" ToolTipService.ToolTip="查看所有传输任务">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE8FD;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="TxtTasksBtn" Text="传输任务" />
                        </StackPanel>
                    </Button>

                    <FontIcon x:Name="TxtStatusIcon" Glyph="&#xE73E;" Foreground="LimeGreen" FontSize="16"
                              VerticalAlignment="Center" Margin="0,0,8,0" DoubleTapped="StatusIcon_DoubleTapped"
                              ToolTipService.ToolTip="当前没有传输任务" />
                </StackPanel>

                <TextBlock x:Name="TxtCurrentPath" Grid.Column="1" Text="{Binding CurrentPath}"
                           VerticalAlignment="Center" HorizontalAlignment="Right"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <!-- 文件列表 -->
        <Grid x:Name="FileListPanel" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Padding="12,6" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="文件名" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="大小" FontWeight="SemiBold" />
                <TextBlock Grid.Column="2" Text="类型" FontWeight="SemiBold" />
                <TextBlock Grid.Column="3" Text="修改时间" FontWeight="SemiBold" />
                <TextBlock Grid.Column="4" Text="权限" FontWeight="SemiBold" />
                <TextBlock Grid.Column="5" Text="用户/用户组" FontWeight="SemiBold" />
            </Grid>

            <ListView
                x:Name="FileGrid"
                Grid.Row="1"
                ItemsSource="{Binding Files}"
                SelectionMode="Multiple"
                AllowDrop="True"
                DragOver="FileGrid_DragOver"
                Drop="FileGrid_Drop"
                DoubleTapped="FileGrid_DoubleTapped"
                HorizontalContentAlignment="Stretch"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.HorizontalScrollMode="Enabled">
                <ListView.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="使用 VS Code 编辑" Click="CtxGridEditVSCode_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE943;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="使用记事本编辑" Click="CtxGridEditNotepad_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE7C3;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="下载" Click="CtxGridDownload_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE896;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="删除" Click="CtxGridDelete_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE74D;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="重命名" Click="CtxGridRename_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE70F;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="复制" Click="CtxGridCopy_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8C8;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="粘贴" Click="CtxGridPaste_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE77F;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </ListView.ContextFlyout>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12,6" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="{Binding IsDirectory, Converter={StaticResource DirGlyph}}" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Size}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding Type}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{Binding Date}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="{Binding Perms}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="5" Text="{Binding Owner}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- 传输任务列表（与文件列表切换显示） -->
        <Grid x:Name="TaskListPanel" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Padding="12,6" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.5*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="文件名" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="远程路径" FontWeight="SemiBold" />
                <TextBlock Grid.Column="2" Text="进度" FontWeight="SemiBold" />
                <TextBlock Grid.Column="3" Text="创建时间" FontWeight="SemiBold" />
                <TextBlock Grid.Column="4" Text="操作" FontWeight="SemiBold" />
            </Grid>

            <ListView
                x:Name="TaskGrid"
                Grid.Row="1"
                ItemsSource="{Binding TransferTasks}"
                SelectionMode="None"
                HorizontalContentAlignment="Stretch">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12,8" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1.5*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding DirectionText}" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="{Binding RemotePath}" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding ProgressText}" FontSize="11" />
                                    <TextBlock Text="{Binding SpeedText}" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Grid.Column="3" Text="{Binding CreatedText}" FontSize="11"
                                       VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button Content="暂停" FontSize="12" Padding="8,2"
                                        Visibility="{Binding CanPause, Converter={StaticResource BoolToVis}}"
                                        Click="TaskPause_Click" />
                                <Button Content="继续" FontSize="12" Padding="8,2"
                                        Visibility="{Binding CanResume, Converter={StaticResource BoolToVis}}"
                                        Click="TaskResume_Click" />
                                <Button Content="取消" FontSize="12" Padding="8,2"
                                        Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}"
                                        Click="TaskCancel_Click" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</UserControl>

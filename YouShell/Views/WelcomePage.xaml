<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="YouShell.Views.WelcomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    FontFamily="Microsoft YaHei">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Margin="20,20,20,0">
            <TextBlock Text="已保存的主机列表:" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Left" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Command="{Binding OpenSettingsCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE713;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="设置" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding OpenKeyManagerCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE72E;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="密钥管理" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding AddConnectionCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE710;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="新建连接" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 主机表格 -->
        <Grid Grid.Row="1" Margin="20,12,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 表头 -->
            <Grid Padding="12,8" ColumnSpacing="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="0.8*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="主机名" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="IP" FontWeight="SemiBold" />
                <TextBlock Grid.Column="2" Text="地理位置" FontWeight="SemiBold" />
                <TextBlock Grid.Column="3" Text="用户名" FontWeight="SemiBold" />
                <TextBlock Grid.Column="4" Text="端口" FontWeight="SemiBold" />
            </Grid>

            <ListView
                x:Name="HostsList"
                Grid.Row="1"
                ItemsSource="{Binding Hosts}"
                SelectedItem="{Binding SelectedHost}"
                SelectionMode="Single"
                DoubleTapped="HostsList_DoubleTapped"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.HorizontalScrollMode="Disabled">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12,8" ColumnSpacing="8" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="0.8*" />
                            </Grid.ColumnDefinitions>
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="连接主机" Click="MnuConnect_Click" />
                                    <MenuFlyoutItem Text="编辑连接" Click="MnuEdit_Click" />
                                    <MenuFlyoutItem Text="删除连接" Click="MnuDelete_Click" />
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"
                                          Visibility="{Binding UseVault, Converter={StaticResource BoolToVis}}"
                                          ToolTipService.ToolTip="由 Windows Hello 凭据保险箱保护" />
                                <TextBlock Text="{Binding HostName}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding IpAddress}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{Binding SimpleIpGEO}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="3" Text="{Binding SshUser}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="4" Text="{Binding SshPort}" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Footer（右下角） -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="2" Margin="0,0,20,12">
            <TextBlock Text="Under " Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" VerticalAlignment="Center" />
            <HyperlinkButton Content="MIT License" NavigateUri="https://opensource.org/licenses/MIT" FontSize="11" Padding="0" />
            <TextBlock Text=" | Code By " Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" VerticalAlignment="Center" />
            <HyperlinkButton Content="关晓予" NavigateUri="https://github.com/fsquirt" FontSize="11" Padding="0" />
            <TextBlock Text=" | Powered By " Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" VerticalAlignment="Center" />
            <HyperlinkButton Content=".NET 10" NavigateUri="https://dotnet.microsoft.com" FontSize="11" Padding="0" />
        </StackPanel>
    </Grid>
</UserControl>

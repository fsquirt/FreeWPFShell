<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="YouShell.Views.SshTunnelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent" FontFamily="Microsoft YaHei" FontSize="15">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15" Spacing="10">
            <Grid ColumnSpacing="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="160" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="目标主机:" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" Margin="0,0,20,0"
                          ItemsSource="{Binding ActiveSessions}"
                          DisplayMemberPath="DisplayName"
                          SelectedItem="{Binding SelectedSession}" />
                <TextBlock Grid.Column="2" Text="隧道类型:" VerticalAlignment="Center" />
                <ComboBox Grid.Column="3" SelectedIndex="{Binding TunnelTypeIndex}">
                    <ComboBoxItem Content="服务器 -> 本机" />
                    <ComboBoxItem Content="本机 -> 服务器" />
                </ComboBox>
            </Grid>

            <Grid ColumnSpacing="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="本机端口:" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding BindPort}" />
                <TextBlock Text="&lt;-&gt;" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,4,0" />
                <TextBlock Text="服务器地址:" Grid.Column="3" VerticalAlignment="Center" />
                <TextBox Grid.Column="4" Text="{Binding DestAddr}" />
                <TextBlock Text=":" Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,4,0" />
                <TextBlock Text="服务器端口:" Grid.Column="6" VerticalAlignment="Center" />
                <TextBox Grid.Column="7" Text="{Binding DestPort}" />
                <Button Grid.Column="8" Content="添加隧道" Command="{Binding AddTunnelCommand}" />
            </Grid>

            <Grid ColumnSpacing="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="隧道备注:" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding Remark}" />
            </Grid>
        </StackPanel>

        <!-- 隧道列表 -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Padding="12,6" ColumnSpacing="8" Background="#1AFFFFFF">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="主机名称" FontWeight="SemiBold" Foreground="#78909C" />
                <TextBlock Grid.Column="1" Text="方向" FontWeight="SemiBold" Foreground="#78909C" />
                <TextBlock Grid.Column="2" Text="映射路线" FontWeight="SemiBold" Foreground="#78909C" />
                <TextBlock Grid.Column="3" Text="备注" FontWeight="SemiBold" Foreground="#78909C" />
                <TextBlock Grid.Column="4" Text="操作" FontWeight="SemiBold" Foreground="#78909C" />
            </Grid>

            <ListView
                x:Name="TunnelList"
                Grid.Row="1"
                ItemsSource="{Binding ActiveTunnels}"
                HorizontalContentAlignment="Stretch"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12,8" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="250" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding HostName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Type}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding PortMapping}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{Binding Remark}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <Button Grid.Column="4" Content="删除" Click="BtnDeleteTunnel_Click" Padding="5,2" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</UserControl>

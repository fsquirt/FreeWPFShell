<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="YouShell.Views.SystemManagementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent" FontFamily="Microsoft YaHei" FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部 Tab 按钮 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="5" Margin="10,8,10,0">
            <Button x:Name="BtnTabProcess" Content="进程管理" Click="BtnTabProcess_Click" />
            <Button x:Name="BtnTabNet" Content="网络连接" Click="BtnTabNet_Click" />
            <Button x:Name="BtnTabLogin" Content="登录记录" Click="BtnTabLogin_Click" />
            <Button x:Name="BtnTabService" Content="服务管理" Click="BtnTabService_Click" />
            <Button x:Name="BtnTabCron" Content="计划任务" Click="BtnTabCron_Click" />
        </StackPanel>

        <!-- 进程管理面板 -->
        <Grid x:Name="PanelProcess" Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
                <TextBlock Text="进程列表" VerticalAlignment="Center" FontWeight="Bold" FontSize="16" />
                <TextBlock Text="搜索:" VerticalAlignment="Center" Margin="12,0,0,0" />
                <TextBox x:Name="TxtProcessSearch" Width="150" TextChanged="TxtProcessSearch_TextChanged" />
                <TextBlock Text="过滤空路径" VerticalAlignment="Center" />
                <ToggleSwitch x:Name="TogFilterEmpty" IsOn="{Binding FilterEmpty, Mode=TwoWay}" OnContent="启用" OffContent="禁止" VerticalAlignment="Center" />
                <Button x:Name="BtnRefreshProcess" Content="刷新" Click="BtnRefreshProcess_Click" Margin="8,0,0,0" />
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Padding="12,6" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60" /><ColumnDefinition Width="80" />
                        <ColumnDefinition Width="60" /><ColumnDefinition Width="60" />
                        <ColumnDefinition Width="200" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="PID" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="用户" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="CPU" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="3" Text="内存" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="4" Text="路径" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="5" Text="命令行" FontWeight="SemiBold" />
                </Grid>
                <ListView x:Name="ProcessGrid" Grid.Row="1" ItemsSource="{Binding ProcessRecords}"
                          SelectedItem="{Binding SelectedProcess, Mode=TwoWay}"
                          SelectionMode="Single" HorizontalContentAlignment="Stretch">
                    <ListView.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="发送 SIGTERM (Kill)" Click="CtxKill_Click" />
                            <MenuFlyoutItem Text="发送 SIGKILL (Kill -9)" Click="CtxKillForce_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="全部结束 (Killall)" Click="CtxKillAll_Click" />
                            <MenuFlyoutItem Text="全部强行结束 (Killall -9)" Click="CtxKillAllForce_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="复制 PID" Click="CtxCopyPid_Click" />
                        </MenuFlyout>
                    </ListView.ContextFlyout>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="12,6" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" /><ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="60" /><ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="200" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Pid}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding User}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Cpu}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding Mem}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="{Binding File}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="5" Text="{Binding Cmd}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Border Grid.Row="2" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Margin="0,5,0,0" Padding="10" Background="{ThemeResource SubtleFillColorSecondaryBrush}" MaxHeight="180">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding ProcessDetailText}" TextWrapping="Wrap" FontFamily="Consolas, Microsoft YaHei" FontSize="12" />
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 网络连接面板 -->
        <Grid x:Name="PanelNet" Grid.Row="1" Margin="10" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
                <TextBlock Text="网络连接" VerticalAlignment="Center" FontWeight="Bold" FontSize="16" />
                <TextBlock Text="搜索:" VerticalAlignment="Center" Margin="12,0,0,0" />
                <TextBox x:Name="TxtNetSearch" Width="150" TextChanged="TxtNetSearch_TextChanged" />
                <Button x:Name="BtnRefreshNet" Content="刷新" Click="BtnRefreshNet_Click" Margin="8,0,0,0" />
                <TextBlock Text="隐藏空路径" VerticalAlignment="Center" />
                <ToggleSwitch x:Name="TogFilterEmptyNet" IsOn="{Binding FilterEmptyNet, Mode=TwoWay}" OnContent="启用" OffContent="禁止" VerticalAlignment="Center" />
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Padding="12,6" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60" /><ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="1.5*" /><ColumnDefinition Width="100" />
                        <ColumnDefinition Width="60" /><ColumnDefinition Width="80" /><ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="协议" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="本地地址" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="远程地址" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="3" Text="状态" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="4" Text="PID" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="5" Text="用户" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="6" Text="程序路径" FontWeight="SemiBold" />
                </Grid>
                <ListView x:Name="NetGrid" Grid.Row="1" ItemsSource="{Binding NetConns}"
                          SelectedItem="{Binding SelectedNetConn, Mode=TwoWay}"
                          SelectionMode="Single" HorizontalContentAlignment="Stretch">
                    <ListView.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="发送 SIGTERM (Kill)" Click="CtxKillNet_Click" />
                            <MenuFlyoutItem Text="发送 SIGKILL (Kill -9)" Click="CtxKillNetForce_Click" />
                        </MenuFlyout>
                    </ListView.ContextFlyout>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="12,6" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" /><ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="1.5*" /><ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="60" /><ColumnDefinition Width="80" /><ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Proto}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Local}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Remote}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding State}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="{Binding Pid}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="5" Text="{Binding User}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="6" Text="{Binding Program}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <!-- 登录记录面板 -->
        <ScrollViewer x:Name="PanelLogin" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
            <StackPanel Margin="10,8,10,10" Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="登录成功记录" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" />
                    <TextBlock Text="/var/log/wtmp" FontSize="11" VerticalAlignment="Center" />
                    <TextBlock Text="获取条数:" VerticalAlignment="Center" Margin="12,0,0,0" />
                    <TextBox x:Name="TxtWtmpCount" Width="60" Text="10" />
                    <Button x:Name="BtnRefreshWtmp" Content="刷新" Click="BtnRefreshWtmp_Click" />
                    <Button x:Name="BtnExportWtmp" Content="导出CSV" Click="BtnExportWtmp_Click" />
                </StackPanel>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Padding="12,6" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" /><ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1.5*" /><ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="登录时间" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="登录用户" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="登录来源 (IP)" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="IP归属地" FontWeight="SemiBold" />
                    </Grid>
                    <ListView x:Name="WtmpGrid" Grid.Row="1" ItemsSource="{Binding WtmpRecords}" SelectionMode="Single" HorizontalContentAlignment="Stretch" MaxHeight="220">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="12,6" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" /><ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="1.5*" /><ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Time}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding User}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding Ip}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding Geo}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <TextBlock Text="登录失败记录" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" />
                    <TextBlock Text="/var/log/btmp" FontSize="11" VerticalAlignment="Center" />
                    <TextBlock Text="获取条数:" VerticalAlignment="Center" Margin="12,0,0,0" />
                    <TextBox x:Name="TxtBtmpCount" Width="60" Text="10" />
                    <Button x:Name="BtnRefreshBtmp" Content="刷新" Click="BtnRefreshBtmp_Click" />
                    <Button x:Name="BtnExportBtmp" Content="导出CSV" Click="BtnExportBtmp_Click" />
                </StackPanel>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Padding="12,6" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" /><ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1.5*" /><ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="登录时间" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="登录用户" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="登录来源 (IP)" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="IP归属地" FontWeight="SemiBold" />
                    </Grid>
                    <ListView x:Name="BtmpGrid" Grid.Row="1" ItemsSource="{Binding BtmpRecords}" SelectionMode="Single" HorizontalContentAlignment="Stretch" MaxHeight="220">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="12,6" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" /><ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="1.5*" /><ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Time}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding User}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding Ip}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding Geo}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- 服务管理面板 -->
        <Grid x:Name="PanelService" Grid.Row="1" Margin="10" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
                <TextBlock Text="服务管理" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" />
                <TextBlock Text="搜索:" VerticalAlignment="Center" Margin="12,0,0,0" />
                <TextBox x:Name="TxtServiceSearch" Width="150" TextChanged="TxtServiceSearch_TextChanged" />
                <Button x:Name="BtnRefreshServices" Content="刷新" Click="BtnRefreshServices_Click" />
                <TextBlock Text="仅显示运行中" VerticalAlignment="Center" />
                <ToggleSwitch x:Name="TogFilterInactive" IsOn="{Binding FilterInactive, Mode=TwoWay}" OnContent="启用" OffContent="禁止" VerticalAlignment="Center" />
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Padding="12,6" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.5*" /><ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="1*" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="0.7*" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="服务名称" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="描述" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="状态" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="3" Text="子状态" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="4" Text="加载状态" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="5" Text="PID" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="6" Text="用户" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="7" Text="用户组" FontWeight="SemiBold" />
                </Grid>
                <ListView x:Name="ServiceGrid" Grid.Row="1" ItemsSource="{Binding ServiceRecords}"
                          SelectedItem="{Binding SelectedService, Mode=TwoWay}"
                          SelectionMode="Single" HorizontalContentAlignment="Stretch">
                    <ListView.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="启动服务" Click="CtxServiceStart_Click" />
                            <MenuFlyoutItem Text="停止服务" Click="CtxServiceStop_Click" />
                            <MenuFlyoutItem Text="重启服务" Click="CtxServiceRestart_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="查看日志 (Status)" Click="CtxServiceLog_Click" />
                        </MenuFlyout>
                    </ListView.ContextFlyout>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="12,6" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.5*" /><ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="1*" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="0.7*" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Description}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding ActiveState}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding SubState}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="{Binding LoadState}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="5" Text="{Binding Pid}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="6" Text="{Binding User}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="7" Text="{Binding Group}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <!-- 计划任务面板 -->
        <ScrollViewer x:Name="PanelCron" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
            <StackPanel Margin="10,8,10,10" Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="计划任务" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CronServiceStatus}" FontSize="11" VerticalAlignment="Center" />
                    <TextBlock Text="搜索:" VerticalAlignment="Center" Margin="12,0,0,0" />
                    <TextBox x:Name="TxtCronSearch" Width="150" TextChanged="TxtCronSearch_TextChanged" />
                    <Button x:Name="BtnRefreshCron" Content="刷新" Click="BtnRefreshCron_Click" />
                    <TextBlock Text="隐藏已禁用" VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="TogFilterDisabledCron" IsOn="{Binding FilterDisabledCron, Mode=TwoWay}" OnContent="启用" OffContent="禁止" VerticalAlignment="Center" />
                </StackPanel>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Padding="12,6" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" /><ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="状态" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="时间规则" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="命令" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="原始行" FontWeight="SemiBold" />
                    </Grid>
                    <ListView x:Name="CronGrid" Grid.Row="1" ItemsSource="{Binding CronJobs}"
                              SelectedItem="{Binding SelectedCronJob, Mode=TwoWay}"
                              SelectionMode="Single" HorizontalContentAlignment="Stretch" MaxHeight="240">
                        <ListView.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="启用" Click="CtxCronEnable_Click" />
                                <MenuFlyoutItem Text="禁用" Click="CtxCronDisable_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="删除" Click="CtxCronDelete_Click" />
                            </MenuFlyout>
                        </ListView.ContextFlyout>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="12,6" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" /><ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding ScheduleDescription}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                               ToolTipService.ToolTip="{Binding Schedule}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Command}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding Raw}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="10">
                    <StackPanel Spacing="6">
                        <TextBlock Text="新建计划任务" FontWeight="Bold" FontSize="14" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="执行频率:" VerticalAlignment="Center" />
                            <ComboBox x:Name="CmbCronPreset" Width="150" SelectionChanged="CmbCronPreset_SelectionChanged">
                                <ComboBoxItem Content="每分钟" /><ComboBoxItem Content="每5分钟" />
                                <ComboBoxItem Content="每小时" /><ComboBoxItem Content="每5小时" />
                                <ComboBoxItem Content="每天" /><ComboBoxItem Content="每5天" />
                                <ComboBoxItem Content="每周5" /><ComboBoxItem Content="每月5日" />
                                <ComboBoxItem Content="每年5月5日" /><ComboBoxItem Content="自定义" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="分 时 日 月 周" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox x:Name="TxtCronMin" Width="50" Text="{Binding CronMin}" />
                            <TextBox x:Name="TxtCronHour" Width="50" Text="{Binding CronHour}" />
                            <TextBox x:Name="TxtCronDom" Width="50" Text="{Binding CronDom}" />
                            <TextBox x:Name="TxtCronMonth" Width="50" Text="{Binding CronMonth}" />
                            <TextBox x:Name="TxtCronDow" Width="50" Text="{Binding CronDow}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="命令:" VerticalAlignment="Center" />
                            <TextBox x:Name="TxtCronCommand" Width="360" Text="{Binding CronCommand}" />
                            <Button x:Name="BtnAddCron" Content="添加" Click="BtnAddCron_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

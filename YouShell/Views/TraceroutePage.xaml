<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="YouShell.Views.TraceroutePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent" FontFamily="Microsoft YaHei" FontSize="15">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="0,0,0,10">
            <TextBlock Text="目标:" VerticalAlignment="Center" />
            <TextBox Text="{Binding Target}" Width="220" VerticalAlignment="Center" />
            <Button Content="开始追踪" Command="{Binding StartCommand}" Margin="10,0,0,0" />
            <Button Content="取消" Command="{Binding CancelCommand}"
                    Visibility="{Binding IsCancelVisible, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <!-- 跳点列表 -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Padding="12,6" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="45" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="2.5*" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="#" FontWeight="SemiBold" Foreground="#78909C" />
                <TextBlock Grid.Column="1" Text="IP 地址" FontWeight="SemiBold" Foreground="#78909C" />
                <TextBlock Grid.Column="2" Text="归属地" FontWeight="SemiBold" Foreground="#78909C" />
                <TextBlock Grid.Column="3" Text="延迟" FontWeight="SemiBold" Foreground="#78909C" />
                <TextBlock Grid.Column="4" Text="状态" FontWeight="SemiBold" Foreground="#78909C" />
            </Grid>

            <ListView
                Grid.Row="1"
                ItemsSource="{Binding Hops}"
                HorizontalContentAlignment="Stretch"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12,8" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="45" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="2.5*" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Hop}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Ip}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding SimpleGeo}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{Binding Latency}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="{Binding Status}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Border Grid.Row="2" BorderBrush="#555" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="8" MinHeight="80">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding DetailText}" TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>

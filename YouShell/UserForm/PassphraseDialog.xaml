<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="YouShell.UserForm.PassphraseDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="密钥密码"
    PrimaryButtonText="确定"
    CloseButtonText="取消"
    DefaultButton="Primary"
    PrimaryButtonClick="PassphraseDialog_PrimaryButtonClick">

    <StackPanel Spacing="8">
        <TextBlock Text="请输入 SSH 密钥的密码 (Passphrase):" />
        <PasswordBox x:Name="TxtPassphrase" FontSize="14" />
    </StackPanel>
</ContentDialog>

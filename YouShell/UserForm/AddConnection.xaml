<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="YouShell.UserForm.AddConnection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="新建连接"
    PrimaryButtonText="保存并连接"
    SecondaryButtonText="保存配置"
    CloseButtonText="取消"
    DefaultButton="Primary"
    PrimaryButtonClick="AddConnection_PrimaryButtonClick"
    SecondaryButtonClick="AddConnection_SecondaryButtonClick">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Width="560" Spacing="4" Padding="0,4,0,0">

            <!-- 连接信息区域 -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="备注名:" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" x:Name="txtHostName" />
            </Grid>
            <Grid ColumnSpacing="8" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="主机IP:" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" x:Name="txtHost" />
                <TextBlock Grid.Column="2" Text="端口:" VerticalAlignment="Center" />
                <TextBox Grid.Column="3" x:Name="txtPort" Text="22" />
            </Grid>
            <Grid ColumnSpacing="8" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="用户名:" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" x:Name="txtUsername" Text="root" />
            </Grid>

            <!-- 认证方式区域 -->
            <StackPanel Margin="0,8,0,0" Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="密码登录" VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="rbPassword" IsOn="True" OnContent="启用" OffContent="禁止" Toggled="rbPassword_Toggled" />
                </StackPanel>
                <Grid Margin="20,0,0,4" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="密码:" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" x:Name="txtPassword" />
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="密钥登录" VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="rbKey" OnContent="启用" OffContent="禁止" Toggled="rbKey_Toggled" />
                </StackPanel>
                <StackPanel Margin="20,0,0,4" Spacing="4">
                    <ComboBox x:Name="cmbKeySelect" HorizontalAlignment="Stretch"
                              DisplayMemberPath="DisplayText" SelectedValuePath="Id" />
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon Glyph="&#xE946;" FontSize="12" Foreground="#78909C" />
                        <TextBlock Text="请先在主界面的「密钥管理」中导入密钥" FontSize="11" Foreground="#78909C" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- 代理设置区域 -->
            <StackPanel Margin="0,8,0,0" Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="启用代理" VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="chkProxy" OnContent="启用" OffContent="禁止" Toggled="chkProxy_Toggled" />
                </StackPanel>
                <ContentControl x:Name="pnlProxy" IsEnabled="False" Margin="0,4,0,0">
                    <StackPanel Spacing="4">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="类型:" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" x:Name="cmbProxyType" SelectedIndex="0"
                                  SelectionChanged="CmbProxyType_SelectionChanged">
                            <ComboBoxItem Content="HTTP" />
                            <ComboBoxItem Content="SOCKS4" />
                            <ComboBoxItem Content="SOCKS5" />
                            <ComboBoxItem Content="SSH隧道" />
                        </ComboBox>
                    </Grid>

                    <!-- HTTP/SOCKS 代理面板 -->
                    <StackPanel x:Name="pnlNetProxy" Spacing="4">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="代理IP:" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="txtProxyHost" />
                            <TextBlock Grid.Column="2" Text="端口:" VerticalAlignment="Center" />
                            <TextBox Grid.Column="3" x:Name="txtProxyPort" Text="10808" />
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="用户名:" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="txtProxyUsername" />
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="密码:" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="txtProxyPassword" />
                        </Grid>
                    </StackPanel>

                    <!-- SSH 隧道（跳板机）面板 -->
                    <StackPanel x:Name="pnlSshProxy" Visibility="Collapsed" Spacing="4">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="跳板机IP:" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="txtJumpHost" />
                            <TextBlock Grid.Column="2" Text="端口:" VerticalAlignment="Center" />
                            <TextBox Grid.Column="3" x:Name="txtJumpPort" Text="22" />
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="用户名:" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="txtJumpUser" Text="root" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="密码登录" VerticalAlignment="Center" />
                            <ToggleSwitch x:Name="rbJumpPassword" IsOn="True" OnContent="启用" OffContent="禁止" Toggled="rbJumpPassword_Toggled" />
                        </StackPanel>
                        <Grid Margin="20,0,0,4" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="密码:" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="txtJumpPassword" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="密钥登录" VerticalAlignment="Center" />
                            <ToggleSwitch x:Name="rbJumpKey" OnContent="启用" OffContent="禁止" Toggled="rbJumpKey_Toggled" />
                        </StackPanel>
                        <StackPanel x:Name="pnlJumpKey" Visibility="Collapsed" Spacing="4" Margin="20,0,0,4">
                            <ComboBox x:Name="cmbJumpKeySelect" HorizontalAlignment="Stretch"
                                      DisplayMemberPath="DisplayText" SelectedValuePath="Id" />
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE946;" FontSize="12" Foreground="#78909C" />
                                <TextBlock Text="请先在主界面的「密钥管理」中导入密钥" FontSize="11" Foreground="#78909C" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                </ContentControl>
            </StackPanel>

            <!-- 测试代理 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0">
                <Button x:Name="BtnTestProxy" Click="BtnTestProxy_Click">
                    <TextBlock x:Name="TxtTestProxy" Text="测试代理" />
                </Button>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</ContentDialog>

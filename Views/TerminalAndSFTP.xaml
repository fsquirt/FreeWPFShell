<UserControl x:Class="FreeWPFShell.Views.TerminalAndSFTP"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:term="clr-namespace:Microsoft.Terminal.Wpf;assembly=Microsoft.Terminal.Wpf"
             xmlns:mica="clr-namespace:MicaWPF.Controls;assembly=MicaWPF"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="800"
             FontFamily="Microsoft Yahei">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2.0*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Terminal -->
        <Grid Grid.Row="0" Margin="10">
            <term:TerminalControl x:Name="Terminal" Focusable="True" Loaded="Terminal_Loaded" PreviewKeyDown="Terminal_PreviewKeyDown" KeyboardNavigation.DirectionalNavigation="None" KeyboardNavigation.TabNavigation="None" KeyboardNavigation.ControlTabNavigation="None" />
            
            <Border x:Name="PnlLoading" Background="Transparent" Visibility="Visible">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtLoadingStatus" Text="正在连接服务器..." Foreground="White" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <mica:Button x:Name="BtnCancelConnect" Content="取消连接" Margin="0,15,0,0" Width="100" Height="30" Click="BtnCancelConnect_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" ResizeBehavior="PreviousAndNext" ResizeDirection="Rows" Background="Transparent" Focusable="False"/>

        <!-- SFTP -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Height="35" Background="Transparent" Padding="5">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <mica:Button x:Name="BtnBack" Content="⬅️" Click="BtnBack_Click" Margin="0,0,5,0" Width="20" />
                        <mica:Button x:Name="BtnForward" Content="➡️" Click="BtnForward_Click" Margin="0,0,5,0" Width="20" />
                        <mica:Button x:Name="BtnRefresh" Content="🔄" Click="BtnRefresh_Click" Margin="0,0,5,0" Width="20" />
                        <mica:Button x:Name="BtnUp" Content="⬆️" Click="BtnUp_Click" Margin="0,0,5,0" Width="20"/>
                        <mica:Button x:Name="BtnNewFolder" Content="📁" Margin="0,0,10,0" Click="BtnNewFolder_Click" Width="20" />
                        
                        <TextBlock x:Name="TxtCurrentPath" Text="/" VerticalAlignment="Center" Margin="0,0,15,0" />

                        <mica:Button x:Name="BtnUpload" Content="↑ 上传" Margin="0,0,5,0" Click="BtnUpload_Click" Width="50">
                            <mica:Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="上传文件" Click="CtxUploadFile_Click" />
                                    <MenuItem Header="上传文件夹" Click="CtxUploadFolder_Click" />
                                </ContextMenu>
                            </mica:Button.ContextMenu>
                        </mica:Button>
                        <mica:Button x:Name="BtnDownload" Content="↓ 下载" Margin="0,0,15,0" Click="BtnDownload_Click" Width="50"/>

                        <TextBlock x:Name="TxtStatusIcon" Text="✅" VerticalAlignment="Center" FontSize="16" Cursor="Help" ToolTip="当前没有传输任务" Margin="0,0,10,0"/>

                        <mica:Button x:Name="BtnSshTunnel" Content="📡" Margin="0,0,10,0" Width="30" Click="BtnSshTunnel_Click" ToolTip="SSH隧道管理" />
                        <mica:Button x:Name="BtnTraceroute" Content="🔭" Margin="0,0,10,0" Width="30" Click="BtnTraceroute_Click" ToolTip="路由追踪" />
                    </StackPanel>
                </Grid>
            </Border>

            <DataGrid x:Name="FileGrid" Grid.Row="1" AutoGenerateColumns="False" HeadersVisibility="Column" Background="Transparent" RowHeaderWidth="0" GridLinesVisibility="None" BorderThickness="0" MouseDoubleClick="FileGrid_MouseDoubleClick" IsReadOnly="True" SelectionMode="Extended">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="下载" Click="CtxGridDownload_Click" />
                        <MenuItem Header="删除" Click="CtxGridDelete_Click" />
                        <MenuItem Header="重命名" Click="CtxGridRename_Click" />
                        <MenuItem Header="复制" Click="CtxGridCopy_Click" />
                        <MenuItem Header="粘贴" Click="CtxGridPaste_Click" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="文件名" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding Name}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="大小" Binding="{Binding Size}" Width="*"/>
                    <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="*"/>
                    <DataGridTextColumn Header="修改时间" Binding="{Binding Date}" Width="1.5*"/>
                    <DataGridTextColumn Header="权限" Binding="{Binding Perms}" Width="*"/>
                    <DataGridTextColumn Header="用户/用户组" Binding="{Binding Owner}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>

<UserControl x:Class="FreeWPFShell.Views.SftpTransferPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mica="clr-namespace:MicaWPF.Controls;assembly=MicaWPF"
             xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="Transparent" FontFamily="Microsoft YaHei" FontSize="14">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <icon:PackIconRemixIcon Kind="DownloadCloud2Line" Foreground="#00BCFF" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBlock Text="传输任务" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Tasks.Count, StringFormat='共 {0} 项'}" VerticalAlignment="Center" Margin="10,0,0,0" Opacity="0.7"/>

            <mica:Button x:Name="BtnPauseAll" Content="暂停所有" Click="BtnPauseAll_Click" Margin="20,0,0,0" Width="90" Height="30"/>
            <mica:Button x:Name="BtnResumeAll" Content="继续所有" Click="BtnResumeAll_Click" Margin="5,0,0,0" Width="90" Height="30"/>
            <mica:Button x:Name="BtnCancelAll" Content="取消所有" Click="BtnCancelAll_Click" Margin="5,0,0,0" Width="90" Height="30"/>
        </StackPanel>

        <DataGrid Grid.Row="1" x:Name="TransferGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  Background="Transparent" RowHeaderWidth="0" GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column" SelectionMode="Single" CanUserAddRows="False"
                  FontFamily="Consolas, Microsoft YaHei" FontSize="12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="文件名" Binding="{Binding FileName}" Width="180"/>
                <DataGridTextColumn Header="本地路径" Binding="{Binding LocalPath}" Width="260"/>
                <DataGridTextColumn Header="远程路径" Binding="{Binding RemotePath}" Width="260"/>
                <DataGridTemplateColumn Header="进度" Width="160">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ProgressBar Grid.Column="0" Minimum="0" Maximum="100" Height="14" VerticalAlignment="Center"
                                             Value="{Binding ProgressPercent, Mode=OneWay}"/>
                                <TextBlock Grid.Column="1" Text="{Binding ProgressText}" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="11"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="速度" Binding="{Binding SpeedText}" Width="110"/>
                <DataGridTemplateColumn Header="操作" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <mica:Button Content="暂停" Click="TaskPause_Click" IsEnabled="{Binding CanPause}" Width="54" Height="24" FontSize="12" Margin="0,0,4,0"/>
                                <mica:Button Content="继续" Click="TaskResume_Click" IsEnabled="{Binding CanResume}" Width="54" Height="24" FontSize="12" Margin="0,0,4,0"/>
                                <mica:Button Content="取消" Click="TaskCancel_Click" IsEnabled="{Binding CanCancel}" Width="54" Height="24" FontSize="12"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>

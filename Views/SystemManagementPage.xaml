<UserControl x:Class="FreeWPFShell.Views.SystemManagementPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mica="clr-namespace:MicaWPF.Controls;assembly=MicaWPF"
             xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="Transparent" FontFamily="Microsoft YaHei" FontSize="14">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部 Tab 按钮 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,8,10,0">
            <mica:Button x:Name="BtnTabProcess" Content="进程管理" Click="BtnTabProcess_Click" Width="100" Height="32" Background="#2D2D30" Foreground="White"/>
            <mica:Button x:Name="BtnTabLogin" Content="登录记录" Click="BtnTabLogin_Click" Margin="5,0,0,0" Width="100" Height="32" Background="Transparent" Foreground="Gray"/>
            <mica:Button x:Name="BtnTabService" Content="服务管理" Click="BtnTabService_Click" Margin="5,0,0,0" Width="100" Height="32" Background="Transparent" Foreground="Gray"/>
        </StackPanel>

        <!-- 进程管理面板 -->
        <Grid x:Name="PanelProcess" Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="200"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <icon:PackIconRemixIcon Kind="PulseLine" Foreground="#F44336" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBlock Text="进程列表" VerticalAlignment="Center" FontWeight="Bold" FontSize="16"/>

                <TextBlock Text="搜索:" VerticalAlignment="Center" Margin="20,0,5,0"/>
                <mica:TextBox x:Name="TxtProcessSearch" Width="150" Height="26" TextChanged="TxtProcessSearch_TextChanged"/>

                <mica:ToggleSwitch x:Name="TogFilterEmpty" Content="过滤空路径" IsChecked="True" VerticalAlignment="Center" Margin="20,0,0,0" Click="TogFilterEmpty_Click" />

                <mica:Button x:Name="BtnRefreshProcess" Content="刷新" Click="BtnRefreshProcess_Click" Margin="20,0,0,0" Width="60" Height="26"/>
            </StackPanel>

            <DataGrid Grid.Row="1" x:Name="ProcessGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      Background="Transparent" RowHeaderWidth="0" GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column" SelectionMode="Single" SelectionChanged="ProcessGrid_SelectionChanged" FontFamily="Consolas, Microsoft YaHei" FontSize="13">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="发送 SIGTERM (Kill)" Click="CtxKill_Click" />
                        <MenuItem Header="发送 SIGKILL (Kill -9)" Click="CtxKillForce_Click" />
                        <Separator />
                        <MenuItem Header="全部结束 (Killall)" Click="CtxKillAll_Click" />
                        <MenuItem Header="全部强行结束 (Killall -9)" Click="CtxKillAllForce_Click" />
                        <Separator />
                        <MenuItem Header="复制 PID" Click="CtxCopyPid_Click" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="60"/>
                    <DataGridTextColumn Header="用户" Binding="{Binding User}" Width="80"/>
                    <DataGridTextColumn Header="CPU" Binding="{Binding Cpu}" Width="60"/>
                    <DataGridTextColumn Header="内存" Binding="{Binding Mem}" Width="60"/>
                    <DataGridTextColumn Header="路径" Binding="{Binding File}" Width="200"/>
                    <DataGridTextColumn Header="命令行" Binding="{Binding Cmd}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" ResizeBehavior="PreviousAndNext" ResizeDirection="Rows" Background="Transparent"/>

            <Border Grid.Row="3" BorderBrush="#555" BorderThickness="0,1,0,0" Margin="0,5,0,0" Padding="10" Background="#1A000000">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="TxtProcessDetail" Text="请从上方列表中选择一个进程以查看详细信息..." TextWrapping="Wrap" FontFamily="Consolas, Microsoft YaHei" FontSize="12" />
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 登录记录面板 -->
        <ScrollViewer x:Name="PanelLogin" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
            <StackPanel Margin="10,8,10,10">

                <!-- 登录成功标题栏 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <icon:PackIconRemixIcon Kind="LoginBoxLine" Foreground="#4CAF50" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="登录成功记录" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text="/var/log/wtmp" FontSize="11" Foreground="Gray" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBlock Text="获取条数:" VerticalAlignment="Center" Margin="20,0,5,0"/>
                    <mica:TextBox x:Name="TxtWtmpCount" Width="60" Height="26" Text="10"/>
                    <mica:Button x:Name="BtnRefreshWtmp" Content="刷新" Click="BtnRefreshWtmp_Click" Margin="10,0,0,0" Width="60" Height="26"/>
                    <mica:Button x:Name="BtnExportWtmp" Click="BtnExportWtmp_Click" Margin="10,0,0,0" Width="75" Height="26">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconRemixIcon Kind="Download2Line" Foreground="#4CAF50" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,3,0"/>
                            <TextBlock Text="导出CSV" VerticalAlignment="Center"/>
                        </StackPanel>
                    </mica:Button>
                </StackPanel>

                <DataGrid x:Name="WtmpGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          Background="Transparent" RowHeaderWidth="0" GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column" SelectionMode="Single" FontFamily="Consolas, Microsoft YaHei"
                          Margin="0,0,0,12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="登录时间" Binding="{Binding Time}" Width="2*"/>
                        <DataGridTextColumn Header="登录用户" Binding="{Binding User}" Width="1*"/>
                        <DataGridTextColumn Header="登录来源 (IP)" Binding="{Binding Ip}" Width="1.5*"/>
                        <DataGridTextColumn Header="IP归属地" Binding="{Binding Geo}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- 登录失败标题栏 -->
                <StackPanel Orientation="Horizontal" Margin="0,5,0,8">
                    <icon:PackIconRemixIcon Kind="ShieldLine" Foreground="#F44336" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="登录失败记录" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text="/var/log/btmp" FontSize="11" Foreground="Gray" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBlock Text="获取条数:" VerticalAlignment="Center" Margin="20,0,5,0"/>
                    <mica:TextBox x:Name="TxtBtmpCount" Width="60" Height="26" Text="10"/>
                    <mica:Button x:Name="BtnRefreshBtmp" Content="刷新" Click="BtnRefreshBtmp_Click" Margin="10,0,0,0" Width="60" Height="26"/>
                    <mica:Button x:Name="BtnExportBtmp" Click="BtnExportBtmp_Click" Margin="10,0,0,0" Width="75" Height="26">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconRemixIcon Kind="Download2Line" Foreground="#F44336" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,3,0"/>
                            <TextBlock Text="导出CSV" VerticalAlignment="Center"/>
                        </StackPanel>
                    </mica:Button>
                </StackPanel>

                <DataGrid x:Name="BtmpGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          Background="Transparent" RowHeaderWidth="0" GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column" SelectionMode="Single" FontFamily="Consolas, Microsoft YaHei">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="登录时间" Binding="{Binding Time}" Width="2*"/>
                        <DataGridTextColumn Header="登录用户" Binding="{Binding User}" Width="1*"/>
                        <DataGridTextColumn Header="登录来源 (IP)" Binding="{Binding Ip}" Width="1.5*"/>
                        <DataGridTextColumn Header="IP归属地" Binding="{Binding Geo}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>

            </StackPanel>
        </ScrollViewer>

        <!-- 服务管理面板 -->
        <ScrollViewer x:Name="PanelService" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
            <StackPanel Margin="10,8,10,10">

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <icon:PackIconRemixIcon Kind="Settings2Line" Foreground="#2196F3" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="服务管理" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text="systemd (D-Bus)" FontSize="11" Foreground="Gray" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBlock Text="搜索:" VerticalAlignment="Center" Margin="20,0,5,0"/>
                    <mica:TextBox x:Name="TxtServiceSearch" Width="150" Height="26" TextChanged="TxtServiceSearch_TextChanged"/>
                    <mica:Button x:Name="BtnRefreshServices" Content="刷新" Click="BtnRefreshServices_Click" Margin="10,0,0,0" Width="60" Height="26"/>
                    <mica:ToggleSwitch x:Name="TogFilterInactive" Content="仅显示运行中" IsChecked="True" VerticalAlignment="Center" Margin="15,0,0,0" Click="TogFilterInactive_Click"/>
                </StackPanel>

                <DataGrid x:Name="ServiceGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          Background="Transparent" RowHeaderWidth="0" GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column" SelectionMode="Single" FontFamily="Consolas, Microsoft YaHei">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="启动服务" Click="CtxServiceStart_Click">
                                <MenuItem.Icon>
                                    <icon:PackIconRemixIcon Kind="PlayCircleLine" Foreground="#4CAF50" Width="14" Height="14"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="停止服务" Click="CtxServiceStop_Click">
                                <MenuItem.Icon>
                                    <icon:PackIconRemixIcon Kind="StopCircleLine" Foreground="#F44336" Width="14" Height="14"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="重启服务" Click="CtxServiceRestart_Click">
                                <MenuItem.Icon>
                                    <icon:PackIconRemixIcon Kind="RestartLine" Foreground="#FF9800" Width="14" Height="14"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="查看日志 (Status)" Click="CtxServiceLog_Click">
                                <MenuItem.Icon>
                                    <icon:PackIconRemixIcon Kind="FileList3Line" Foreground="#2196F3" Width="14" Height="14"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="服务名称" Binding="{Binding Name}" Width="2.5*"/>
                        <DataGridTextColumn Header="描述" Binding="{Binding Description}" Width="3*"/>
                        <DataGridTextColumn Header="状态" Binding="{Binding ActiveState}" Width="1*"/>
                        <DataGridTextColumn Header="子状态" Binding="{Binding SubState}" Width="1*"/>
                        <DataGridTextColumn Header="加载状态" Binding="{Binding LoadState}" Width="1*"/>
                        <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="0.7*"/>
                        <DataGridTextColumn Header="用户" Binding="{Binding User}" Width="1*"/>
                        <DataGridTextColumn Header="用户组" Binding="{Binding Group}" Width="1*"/>
                    </DataGrid.Columns>
                </DataGrid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

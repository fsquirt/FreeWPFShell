<UserControl x:Class="FreeWPFShell.Views.DebugConsolePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mica="clr-namespace:MicaWPF.Controls;assembly=MicaWPF"
             Background="Transparent" FontFamily="Microsoft YaHei">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <mica:Button Content="立即 GC" Height="34" Padding="14,0" Margin="0,0,8,0" Click="BtnGc_Click"/>
            <mica:Button Content="启动 TerminalForm" Height="34" Padding="14,0" Margin="0,0,8,0" Click="BtnTerminalForm_Click"/>
            <mica:Button Content="启动 TerminalWithOther" Height="34" Padding="14,0" Click="BtnTerminalWithOther_Click"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#26808080"
                BorderBrush="#59808080"
                BorderThickness="1"
                CornerRadius="6">
            <TextBox x:Name="OutputBox"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     FontFamily="Consolas, Microsoft YaHei"
                     FontSize="12"
                     Padding="10"
                     BorderThickness="0"
                     Background="Transparent"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto" />
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="FreeWPFShell.Views.DebugConsolePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" FontFamily="Microsoft YaHei">
    <Grid Margin="10">
        <Border Background="#26808080"
                BorderBrush="#59808080"
                BorderThickness="1"
                CornerRadius="6">
            <TextBox x:Name="OutputBox"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     FontFamily="Consolas, Microsoft YaHei"
                     FontSize="12"
                     Padding="10"
                     BorderThickness="0"
                     Background="Transparent"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto" />
        </Border>
    </Grid>
</UserControl>

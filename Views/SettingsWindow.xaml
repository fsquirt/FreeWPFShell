    <mica:MicaWindow x:Class="FreeWPFShell.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mica="clr-namespace:MicaWPF.Controls;assembly=MicaWPF"
        mc:Ignorable="d"
        Title="设置" Height="700" Width="420"
        SystemBackdropType="Acrylic"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FontFamily="Microsoft YaHei">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="安全设置" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,5">
            <mica:ToggleSwitch x:Name="TogVault" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="使用 Windows Hello 保护密码" FontSize="14" VerticalAlignment="Center" ToolTip="启用后，新保存的凭据将强制要求通过本机 PIN 或生物识别才能解锁。"/>
        </StackPanel>
        
        <TextBlock Grid.Row="2" Text="注：开启此选项后，密码将存入 Windows 凭据保险箱。如果你的电脑未设置开机密码或 PIN，请不要勾选，否则会导致无法连接。" TextWrapping="Wrap" Foreground="#909090" FontSize="12" Margin="0,5,0,15"/>

        <TextBlock Grid.Row="3" Text="系统设置" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

        <StackPanel Grid.Row="4" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <mica:ToggleSwitch x:Name="TogLinuxMonitor" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="使用 Linux Monitor 代理进程监视" FontSize="14" VerticalAlignment="Center" ToolTip="启用后将自动建立SSH端口转发并挂载Native探针，大幅优化监控性能。"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <TextBlock Text="窗口背景渲染：" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="CmbBackdrop" Width="120" VerticalAlignment="Center" SelectionChanged="CmbBackdrop_SelectionChanged" Height="34">
                    <ComboBoxItem Content="None" Tag="None"/>
                    <ComboBoxItem Content="Mica" Tag="Mica"/>
                    <ComboBoxItem Content="Acrylic" Tag="Acrylic"/>
                    <ComboBoxItem Content="Tabbed" Tag="Tabbed"/>
                </ComboBox>
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="5" Text="路由追踪设置" FontSize="20" FontWeight="Bold" Margin="0,15,0,15"/>

        <StackPanel Grid.Row="6">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="路由追踪超时(秒)：" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <mica:TextBox x:Name="TxtTraceTimeout" Width="60" VerticalAlignment="Center" />
                <TextBlock Text="最大跳数：" FontSize="14" VerticalAlignment="Center" Margin="20,0,8,0"/>
                <mica:TextBox x:Name="TxtTraceMaxHops" Width="60" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="7" Text="终端设置" FontSize="20" FontWeight="Bold" Margin="0,15,0,15"/>

        <StackPanel Grid.Row="8">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="终端纯色背景：" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <mica:TextBox x:Name="TxtTerminalBg" Width="200" ToolTip="例如: #1E3047 或 Red" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="终端字体：" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <mica:TextBox x:Name="TxtTerminalFont" Width="140" ToolTip="例如: Cascadia Code" />
                <TextBlock Text="字号：" FontSize="14" VerticalAlignment="Center" Margin="15,0,8,0"/>
                <mica:TextBox x:Name="TxtTerminalFontSize" Width="40" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <mica:ToggleSwitch x:Name="TogImageBg" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="启用图片背景" FontSize="14" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12" IsEnabled="{Binding IsChecked, ElementName=TogImageBg}">
                <TextBlock Text="图片路径：" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <mica:TextBox x:Name="TxtImagePath" Width="200" VerticalAlignment="Center" IsReadOnly="True" />
                <mica:Button Content="选择图片" Width="80" Height="34" VerticalAlignment="Center" Margin="5,0,0,0" Click="BtnSelectImage_Click" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12" IsEnabled="{Binding IsChecked, ElementName=TogImageBg}">
                <TextBlock Text="拉伸模式：" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="CmbStretch" Width="200" Height="34">
                    <ComboBoxItem Content="None (原始)" Tag="0"/>
                    <ComboBoxItem Content="Fill (填充)" Tag="1"/>
                    <ComboBoxItem Content="Uniform (适应)" Tag="2"/>
                    <ComboBoxItem Content="UniformToFill (裁剪)" Tag="3"/>
                    <ComboBoxItem Content="Center (居中)" Tag="4"/>
                </ComboBox>
            </StackPanel>
        </StackPanel>

        <!-- Footer -->
        <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <TextBlock Foreground="#707070" FontSize="11">
                <Run Text="Under "/>
                <Hyperlink NavigateUri="https://opensource.org/licenses/MIT" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#44A8FF">MIT License</Hyperlink>
                <Run Text=" | Code By "/>
                <Hyperlink NavigateUri="https://github.com/fsquirt" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#44A8FF">fsquirt</Hyperlink>
                <Run Text=" | Powered By "/>
                <Hyperlink NavigateUri="https://dotnet.microsoft.com" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#44A8FF">.NET 10</Hyperlink>
            </TextBlock>
        </StackPanel>
    </Grid>
</mica:MicaWindow>

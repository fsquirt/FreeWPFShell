<UserControl x:Class="FreeWPFShell.Views.WelcomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:mica="clr-namespace:MicaWPF.Controls;assembly=MicaWPF"
             xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="800"
             FontFamily="Microsoft YaHei">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="20,20,20,0">
                <TextBlock Text="已保存的主机列表:" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Left" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <mica:Button Margin="0,0,10,0" Padding="10,4" Command="{Binding OpenSettingsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconRemixIcon Kind="Settings3Line" Foreground="#AAA" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="设置" VerticalAlignment="Center"/>
                        </StackPanel>
                    </mica:Button>
                    <mica:Button Margin="0,0,10,0" Padding="10,4" Command="{Binding OpenKeyManagerCommand}">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconRemixIcon Kind="Key2Line" Foreground="#FFD700" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="密钥管理" VerticalAlignment="Center"/>
                        </StackPanel>
                    </mica:Button>
                    <mica:Button Padding="10,4" Command="{Binding AddConnectionCommand}">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconRemixIcon Kind="AddCircleLine" Foreground="#00BCFF" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="新建连接" VerticalAlignment="Center"/>
                        </StackPanel>
                    </mica:Button>
                </StackPanel>
            </Grid>

        <ListBox x:Name="HostsList" 
         Grid.Row="1" 
         Margin="20" 
         Background="Transparent" 
         BorderThickness="0" 
         HorizontalContentAlignment="Stretch"
         ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
         ScrollViewer.CanContentScroll="False" 
         ItemsSource="{Binding Hosts}"
         SelectedItem="{Binding SelectedHost}"
         MouseDoubleClick="HostsList_MouseDoubleClick">

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="#1C2E41" Margin="5" Padding="15" CornerRadius="8" Width="280">
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="连接主机" Command="{Binding PlacementTarget.DataContext.ConnectCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                <MenuItem Header="编辑连接" Command="{Binding PlacementTarget.DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                <MenuItem Header="删除连接" Command="{Binding PlacementTarget.DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                            </ContextMenu>
                        </Border.ContextMenu>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <icon:PackIconRemixIcon Kind="LockPasswordLine" Foreground="#00BCFF" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,5,0" ToolTip="由 Windows Hello 凭据保险箱保护">
                                    <icon:PackIconRemixIcon.Style>
                                        <Style TargetType="icon:PackIconRemixIcon">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UseVault}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </icon:PackIconRemixIcon.Style>
                                </icon:PackIconRemixIcon>
                                <TextBlock Text="{Binding HostName}" FontWeight="Bold" FontSize="16" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding IpAddress}" FontSize="13" Foreground="#B0BEC5"/>
                            <TextBlock Text="{Binding SimpleIpGEO}" FontSize="11" Foreground="#78909C" Margin="0,2,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <TextBlock Text="{Binding SshUser}" FontSize="12" Foreground="#78909C"/>
                                <TextBlock Text=" : " FontSize="12" Foreground="#78909C"/>
                                <TextBlock Text="{Binding SshPort}" FontSize="12" Foreground="#78909C"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>

            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" 
                       Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollContentPresenter}}" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </Grid>
</UserControl>

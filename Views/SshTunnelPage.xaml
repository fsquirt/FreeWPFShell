<UserControl x:Class="FreeWPFShell.Views.SshTunnelPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mica="clr-namespace:MicaWPF.Controls;assembly=MicaWPF"
             Background="Transparent" FontFamily="Microsoft YaHei" FontSize="16">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <StackPanel Margin="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Text="目标主机:" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" Margin="5,0,20,0"
                              ItemsSource="{Binding ActiveSessions}"
                              DisplayMemberPath="DisplayName"
                              SelectedItem="{Binding SelectedSession}" />
                    
                    <TextBlock Grid.Column="2" Text="隧道类型:" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="3" Margin="5,0,0,0"
                              SelectedIndex="{Binding TunnelTypeIndex}">
                        <ComboBoxItem Content="服务器 -> 本机" />
                        <ComboBoxItem Content="本机 -> 服务器" />
                    </ComboBox>
                </Grid>

                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="85"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="本机端口:" VerticalAlignment="Center"/>
                    <mica:TextBox Grid.Column="1" Text="{Binding BindPort}" />
                    
                    <TextBlock Text="&lt;-&gt;" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    
                    <TextBlock Text="服务器地址:" Grid.Column="3" VerticalAlignment="Center" />
                    <mica:TextBox Grid.Column="4" Text="{Binding DestAddr}" />

                    <TextBlock Text=":" Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    
                    <TextBlock Text="服务器端口:" Grid.Column="6" VerticalAlignment="Center" />
                    <mica:TextBox Grid.Column="7" Text="{Binding DestPort}" />
                    
                    <mica:Button Grid.Column="9" Content="添加隧道" Command="{Binding AddTunnelCommand}" Height="30"/>
                </Grid>
                
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="隧道备注:" VerticalAlignment="Center"/>
                    <mica:TextBox Grid.Column="1" Margin="5,0,0,0" Text="{Binding Remark}" />
                </Grid>
            </StackPanel>
        </StackPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding ActiveTunnels}" AutoGenerateColumns="False" IsReadOnly="True" 
                  Background="#1AFFFFFF" RowBackground="Transparent" AlternatingRowBackground="#0DFFFFFF"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#33FFFFFF">
            <DataGrid.Columns>
                <DataGridTextColumn Header="主机名称" Binding="{Binding HostName}" Width="150" />
                <DataGridTextColumn Header="方向" Binding="{Binding Type}" Width="80" />
                <DataGridTextColumn Header="映射路线" Binding="{Binding PortMapping}" Width="250" />
                <DataGridTextColumn Header="备注" Binding="{Binding Remark}" Width="*" />
                <DataGridTemplateColumn Header="操作" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <mica:Button Content="删除"
                                         Command="{Binding DataContext.DeleteTunnelCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                         CommandParameter="{Binding}"
                                         Padding="5,2" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>

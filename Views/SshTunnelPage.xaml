<UserControl x:Class="FreeWPFShell.Views.SshTunnelPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mica="clr-namespace:MicaWPF.Controls;assembly=MicaWPF"
             Background="Transparent" FontFamily="Microsoft YaHei">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="手动添加隧道" Margin="0,0,0,15">
            <StackPanel Margin="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Text="目标主机:" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbHosts" Grid.Column="1" Margin="5,0,20,0" />
                    
                    <TextBlock Grid.Column="2" Text="隧道类型:" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbTunnelType" Grid.Column="3" Margin="5,0,0,0" SelectedIndex="0">
                        <ComboBoxItem Content="服务器 -> 本机" />
                        <ComboBoxItem Content="本机 -> 服务器" />
                    </ComboBox>
                </Grid>

                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="本机端口:" VerticalAlignment="Center"/>
                    <mica:TextBox x:Name="TxtBindPort" Grid.Column="1" Text="8080" />
                    
                    <TextBlock Text="&lt;-&gt;" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    
                    <TextBlock Text="服务器地址:" Grid.Column="3" VerticalAlignment="Center" />
                    <mica:TextBox x:Name="TxtDestAddr" Grid.Column="4" Text="127.0.0.1" />

                    <TextBlock Text=":" Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    
                    <TextBlock Text="服务器端口:" Grid.Column="6" VerticalAlignment="Center" />
                    <mica:TextBox x:Name="TxtDestPort" Grid.Column="7" Text="80" />
                    
                    <mica:Button x:Name="BtnAddTunnel" Grid.Column="9" Content="添加隧道" Click="BtnAddTunnel_Click" Height="30"/>
                </Grid>
                
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="隧道备注:" VerticalAlignment="Center"/>
                    <mica:TextBox x:Name="TxtRemark" Grid.Column="1" Margin="5,0,0,0" Text="手动创建" />
                </Grid>
            </StackPanel>
        </GroupBox>

        <DataGrid x:Name="TunnelGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" 
                  Background="#1AFFFFFF" RowBackground="Transparent" AlternatingRowBackground="#0DFFFFFF"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#33FFFFFF">
            <DataGrid.Columns>
                <DataGridTextColumn Header="主机名称" Binding="{Binding HostName}" Width="150" />
                <DataGridTextColumn Header="方向" Binding="{Binding Type}" Width="80" />
                <DataGridTextColumn Header="映射路线" Binding="{Binding PortMapping}" Width="250" />
                <DataGridTextColumn Header="备注" Binding="{Binding Remark}" Width="*" />
                <DataGridTemplateColumn Header="操作" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <mica:Button Content="删除" Tag="{Binding Id}" Click="BtnDeleteTunnel_Click" Padding="5,2" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>

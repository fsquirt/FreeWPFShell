<UserControl x:Class="FreeWPFShell.Pages.TraceroutePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mica="clr-namespace:MicaWPF.Controls;assembly=MicaWPF"
             Background="Transparent" FontFamily="Microsoft YaHei">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="目标:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <mica:TextBox x:Name="TxtTarget" Width="220" VerticalAlignment="Center" />
            <mica:Button x:Name="BtnStart" Content="开始追踪" Click="BtnStart_Click" Margin="10,0,0,0" Height="30" Width="60"/>
            <mica:Button x:Name="BtnCancel" Content="取消" Click="BtnCancel_Click" Margin="5,0,0,0" Height="30" Width="60" Visibility="Collapsed"/>
        </StackPanel>

        <DataGrid Grid.Row="1" x:Name="HopsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  Background="Transparent" RowHeaderWidth="0" GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column" SelectionMode="Single" AlternatingRowBackground="#1A2A3A">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Hop}" Width="45"/>
                <DataGridTextColumn Header="IP 地址" Binding="{Binding Ip}" Width="*"/>
                <DataGridTextColumn Header="归属地" Binding="{Binding SimpleGeo}" Width="2.5*"/>
                <DataGridTextColumn Header="延迟" Binding="{Binding Latency}" Width="70"/>
                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" BorderBrush="#555" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="8" MinHeight="80">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="TxtDetail" Text="输入目标 IP 或域名，点击「开始追踪」" TextWrapping="Wrap" FontSize="12" />
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>

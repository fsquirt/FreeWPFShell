<UserControl x:Class="FreeWPFShell.Pages.WelcomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="800">
    <Grid>
        <StackPanel Margin="20">
            <TextBlock Text="FreeWPFShell" FontSize="26" FontWeight="Bold" Margin="0,0,0,10" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <TextBlock Text="已保存的主机列表:" FontSize="16" VerticalAlignment="Center" />
                <Button x:Name="BtnAddConnection" Content="＋ 新建连接" Margin="15,0,0,0" Padding="10,4" Click="BtnAddConnection_Click" />
            </StackPanel>
            
            <ListBox x:Name="HostsList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="HostsList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#1C2E41" Margin="5" Padding="15" CornerRadius="8" Width="280">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="连接主机" Click="CtxConnect_Click" />
                                    <MenuItem Header="编辑连接" Click="CtxEdit_Click" />
                                    <MenuItem Header="删除连接" Click="CtxDelete_Click" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <StackPanel>
                                <TextBlock Text="{Binding HostName}" FontWeight="Bold" FontSize="16" Foreground="White" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding IpAddress}" FontSize="13" Foreground="#B0BEC5"/>
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <TextBlock Text="{Binding SshUser}" FontSize="12" Foreground="#78909C"/>
                                    <TextBlock Text=" : " FontSize="12" Foreground="#78909C"/>
                                    <TextBlock Text="{Binding SshPort}" FontSize="12" Foreground="#78909C"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </StackPanel>
    </Grid>
</UserControl>

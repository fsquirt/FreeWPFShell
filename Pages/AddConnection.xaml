<Window x:Class="FreeWPFShell.Pages.AddConnection"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FreeWPFShell.Pages"
        mc:Ignorable="d"
        Title="新建连接" Height="600" Width="600"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 连接信息区域 -->
        <GroupBox Grid.Row="0" Header="连接信息" Margin="0,0,0,10">
            <StackPanel Margin="5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="备注名:" VerticalAlignment="Center" Margin="0,5"/>
                    <TextBox Grid.Column="1" x:Name="txtHostName" Margin="5"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="主机IP:" VerticalAlignment="Center" Margin="0,5"/>
                    <TextBox Grid.Column="1" x:Name="txtHost" Margin="5"/>
                    <TextBlock Grid.Column="2" Text="端口:" VerticalAlignment="Center" Margin="5,0"/>
                    <TextBox Grid.Column="3" x:Name="txtPort" Text="22" Margin="0,5"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="用户名:" VerticalAlignment="Center" Margin="0,5"/>
                    <TextBox Grid.Column="1" x:Name="txtUsername" Margin="5"/>
                </Grid>
            </StackPanel>
        </GroupBox>

        <!-- 认证方式区域 -->
        <GroupBox Grid.Row="1" Header="认证方式" Margin="0,0,0,10">
            <StackPanel Margin="5">
                <RadioButton x:Name="rbPassword" Content="密码登录" IsChecked="True" Margin="0,5"/>
                <StackPanel x:Name="pnlPassword" Margin="20,0,0,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="密码:" VerticalAlignment="Center"/>
                        <PasswordBox Grid.Column="1" x:Name="txtPassword" Margin="0,3"/>
                    </Grid>
                </StackPanel>
                <RadioButton x:Name="rbKey" Content="密钥登录" Margin="0,5"/>
                <StackPanel x:Name="pnlKey" Margin="20,0,0,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="txtKeyPath" IsReadOnly="True" Margin="0,3"/>
                        <Button Grid.Column="1" Content="浏览..." Width="60" Margin="5,3" Click="BtnBrowseKey_Click"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- 代理设置区域 -->
        <GroupBox Grid.Row="2" Header="代理服务器设置" Margin="0,0,0,10">
            <StackPanel Margin="5">
                <CheckBox x:Name="chkProxy" Content="启用代理" Margin="0,5" Checked="ChkProxy_Changed" Unchecked="ChkProxy_Changed"/>
                <StackPanel x:Name="pnlProxy" IsEnabled="False">
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="类型:" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" x:Name="cmbProxyType" Margin="5,3" SelectedIndex="0">
                            <ComboBoxItem Content="HTTP"/>
                            <ComboBoxItem Content="SOCKS4"/>
                            <ComboBoxItem Content="SOCKS5"/>
                        </ComboBox>
                        <TextBlock Grid.Column="2" Text="端口:" VerticalAlignment="Center" Margin="5,0"/>
                        <TextBox Grid.Column="3" x:Name="txtProxyPort" Text="1080" Margin="0,3"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="代理IP:" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" x:Name="txtProxyHost" Margin="5,3"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="用户名:" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" x:Name="txtProxyUsername" Margin="5,3"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="密码:" VerticalAlignment="Center"/>
                        <PasswordBox Grid.Column="1" x:Name="txtProxyPassword" Margin="5,3"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- 按钮 -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnSave" Content="保存配置" Width="80" Margin="0,0,10,0" Padding="5" Click="BtnSave_Click"/>
            <Button x:Name="BtnConnect" Content="保存并连接" Width="90" Padding="5" Click="BtnConnect_Click"/>
        </StackPanel>
    </Grid>

</Window>

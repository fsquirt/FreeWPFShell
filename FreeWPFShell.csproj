<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Platforms>AnyCPU;x64</Platforms>
    <UseWindowsForms>False</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="WpfTerminalControl\**" />
    <EmbeddedResource Remove="WpfTerminalControl\**" />
    <None Remove="WpfTerminalControl\**" />
    <Page Remove="WpfTerminalControl\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MicaWPF" Version="6.3.2" />
    <PackageReference Include="Microsoft.Terminal.Wpf" Version="0.1.0" />
    <PackageReference Include="SSH.NET" Version="2025.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="ToolForm\" />
  </ItemGroup>

</Project>

<mica:MicaWindow x:Class="FreeWPFShell.MainForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FreeWPFShell"
        xmlns:mica="clr-namespace:MicaWPF.Controls;assembly=MicaWPF"
        xmlns:term="clr-namespace:Microsoft.Terminal.Wpf;assembly=Microsoft.Terminal.Wpf"
        mc:Ignorable="d"
        Title="FreeWPFShell 0.0.1" Height="720" Width="1280"
        SystemBackdropType="Acrylic"
        Closed="MicaWindow_Closed">

    <DockPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" MinWidth="200" MaxWidth="400"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">
                    <Border BorderBrush="Transparent" BorderThickness="1" CornerRadius="3" Padding="4" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                           
                            <StackPanel Orientation="Horizontal" Grid.Row="1">
                                <TextBlock Text="IP 38.207.165.125" />
                                <Button Content="复制" Margin="10,0,0,0" Padding="5,1" Background="Transparent"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Button Content="系统信息" Height="20" Margin="0,0,0,10" Background="Transparent" BorderBrush="#81D4FA"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="运行 12 天..." Grid.Row="0"/>
                        <TextBlock Text="负载 0.01, 0.02, 0.00" Grid.Row="1" />

                        <Grid Grid.Row="2" Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="CPU" VerticalAlignment="Center"/>
                            <ProgressBar Value="18" Minimum="0" Maximum="100" Height="15" Grid.Column="1" Foreground="#4CAF50" Background="Transparent"/>
                            <TextBlock Text="18%" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Transparent" FontSize="10"/>
                        </Grid>

                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="内存" VerticalAlignment="Center"/>
                            <ProgressBar Value="54" Minimum="0" Maximum="100" Height="15" Grid.Column="1" Foreground="#FF9800" Background="Transparent"/>
                            <TextBlock Text="54%" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="10"/>
                            <TextBlock Text="518M/967M" Grid.Column="2" Margin="5,0,0,0" />
                        </Grid>
                    </Grid>

                    <DataGrid AutoGenerateColumns="False" HeadersVisibility="Column" Height="150" Background="Transparent" RowHeaderWidth="0" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="内存" Binding="{Binding Mem}" Width="*"/>
                            <DataGridTextColumn Header="CPU" Binding="{Binding Cpu}" Width="*"/>
                            <DataGridTextColumn Header="命令" Binding="{Binding Cmd}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="↑ 13K ↓ 15K eth0" Margin="0,10,0,0" FontWeight="Bold" Foreground="#27AE60"/>
                    <Polyline Points="0,20 20,5 40,15 60,0 80,18" Stroke="#27AE60" StrokeThickness="1" Height="20" Margin="0,2"/>

                    <TextBlock Text="46ms" Margin="0,10,0,0"/>
                    <Polyline Points="0,15 20,20 40,5 60,18 80,0" Stroke="#2196F3" StrokeThickness="1" Height="20" Margin="0,2"/>

                    <DataGrid AutoGenerateColumns="False" HeadersVisibility="Column" Height="150" Margin="0,10,0,0" Background="Transparent" RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="*"/>
                            <DataGridTextColumn Header="可用/大小" Binding="{Binding Size}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </ScrollViewer>

            <GridSplitter HorizontalAlignment="Left" Background="Transparent" RenderTransformOrigin="0.5,0.5" Width="0" Grid.Column="2">
                <GridSplitter.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="1"/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </GridSplitter.RenderTransform>
            </GridSplitter>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.5*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TabControl Grid.Row="0" BorderThickness="0" Background="#1E3047">
                    <TabItem Header="📁 1 龙虾" IsSelected="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ScrollViewer Grid.Row="0" Margin="10">
                                <term:TerminalControl x:Name="Terminal" Focusable="True" Loaded="Terminal_Loaded" />
                            </ScrollViewer>

                            <Border Grid.Row="1" Height="30" Background="#263238" Padding="5,0">
                                <Grid>
                                    <TextBlock Text="命令输入 (双击Ctrl切换,Alt历史,Tab路径/命令,Esc关闭窗口)" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Content="历史" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Foreground="White"/>
                                        <Button Content="选项" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Foreground="White" Margin="5,0"/>
                                        <TextBlock Text="⚡ 💾 🛠️ 🔍" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>
                    <TabItem Header="+"/>
                </TabControl>

                <GridSplitter Grid.Row="1" Height="3" HorizontalAlignment="Stretch" Background="Transparent" VerticalAlignment="Top"/>

                <TabControl Grid.Row="2" BorderThickness="0" Background="Transparent">
                    <TabItem Header="文件" IsSelected="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="129*"/>
                                <ColumnDefinition Width="409*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Height="35" Background="Transparent" Padding="5" Grid.ColumnSpan="2">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⬅️ ➡️ 🔄 ⬆️ 📁" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Text="/root" VerticalAlignment="Center" Foreground="#333333"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="历史 🔄 ⬆️" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <DataGrid Grid.Row="1" AutoGenerateColumns="False" HeadersVisibility="Column" Background="Transparent" RowHeaderWidth="0" GridLinesVisibility="Horizontal" Grid.ColumnSpan="2">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="文件名" Width="2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="📁" Margin="0,0,5,0"/>
                                                    <TextBlock Text="{Binding Name}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="大小" Binding="{Binding Size}" Width="*"/>
                                    <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="*"/>
                                    <DataGridTextColumn Header="修改时间" Binding="{Binding Date}" Width="1.5*"/>
                                    <DataGridTextColumn Header="权限" Binding="{Binding Perms}" Width="*"/>
                                    <DataGridTextColumn Header="用户/用户组" Binding="{Binding Owner}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="命令"/>
                </TabControl>
            </Grid>
        </Grid>
    </DockPanel>
</mica:MicaWindow>
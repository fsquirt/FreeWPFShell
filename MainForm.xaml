<mica:MicaWindow x:Class="FreeWPFShell.MainForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FreeWPFShell"
        xmlns:mica="clr-namespace:MicaWPF.Controls;assembly=MicaWPF"
        xmlns:term="clr-namespace:Microsoft.Terminal.Wpf;assembly=Microsoft.Terminal.Wpf"
        mc:Ignorable="d"
        Title="FreeWPFShell 0.0.1" Height="800" Width="1280"
        SystemBackdropType="Acrylic" TitleBarType="WinUI"
        Closed="MicaWindow_Closed">

    <DockPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" MinWidth="200" MaxWidth="400"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Sidebar -->
            <Grid Grid.Column="0" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="Transparent" BorderThickness="1" CornerRadius="3" Padding="4" Margin="0,0,0,10">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="IP 38.207.165.125" />
                            <Button Content="复制" Margin="10,0,0,0" Padding="5,1" Background="Transparent"  />
                        </StackPanel>
                    </Grid>
                </Border>

                <Button Grid.Row="1" Content="系统信息" Height="20" Margin="0,0,0,10" Background="Transparent" BorderBrush="#81D4FA"  />

                <StackPanel Orientation="Horizontal" Grid.Row="2">
                    <TextBlock x:Name="TxtUptime" Text="运行 -- 天..."/>
                    <TextBlock x:Name="TxtPing" Text="--ms" Margin="10,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="TxtLoad" Text="负载 --, --, --" Grid.Row="3" Margin="0,5,0,0"/>

                <Grid Grid.Row="4" Margin="0,10,0,5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="35"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="65"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="CPU" VerticalAlignment="Center" Grid.Row="0"/>
                    <ProgressBar x:Name="ProgCpu" Value="0" Minimum="0" Maximum="100" Height="15" Grid.Column="1" Grid.Row="0" Foreground="#4CAF50" Background="Transparent" Margin="0,2"/>
                    <TextBlock x:Name="TxtCpuPct" Text="0%" Grid.Column="1" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10"/>
                    <TextBlock x:Name="TxtCpuText" Text="0.0%" Grid.Column="2" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Center" />

                    <TextBlock Text="内存" VerticalAlignment="Center" Grid.Row="1"/>
                    <ProgressBar x:Name="ProgMem" Value="0" Minimum="0" Maximum="100" Height="15" Grid.Column="1" Grid.Row="1" Foreground="#FF9800" Background="Transparent" Margin="0,2"/>
                    <TextBlock x:Name="TxtMemPct" Text="0%" Grid.Column="1" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"  FontSize="10"/>
                    <TextBlock x:Name="TxtMemText" Text="0M/0M" Grid.Column="2" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center" />

                    <TextBlock Text="交换" VerticalAlignment="Center" Grid.Row="2"/>
                    <ProgressBar x:Name="ProgSwap" Value="0" Minimum="0" Maximum="100" Height="15" Grid.Column="1" Grid.Row="2" Foreground="#9E9E9E" Background="Transparent" Margin="0,2"/>
                    <TextBlock x:Name="TxtSwapPct" Text="0%" Grid.Column="1" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"  FontSize="10"/>
                    <TextBlock x:Name="TxtSwapText" Text="0M/0M" Grid.Column="2" Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <DataGrid Grid.Row="5" x:Name="ProcessGrid" AutoGenerateColumns="False" HeadersVisibility="Column" Height="150" Background="Transparent" RowHeaderWidth="0" GridLinesVisibility="None" BorderThickness="0" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="内存" Binding="{Binding Mem}" Width="*"/>
                        <DataGridTextColumn Header="CPU" Binding="{Binding Cpu}" Width="*"/>
                        <DataGridTextColumn Header="命令" Binding="{Binding Cmd}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Grid.Row="6" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="↑ "/>
                        <TextBlock x:Name="TxtNetUp" Text="0K" Margin="0,0,10,0"/>
                        <TextBlock Text="↓ "/>
                        <TextBlock x:Name="TxtNetDown" Text="0K"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtNetIface" Text="eth0" Grid.Column="1"/>
                </Grid>
                
                <Grid Grid.Row="7" Height="80" Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="35"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Vertical" VerticalAlignment="Stretch" HorizontalAlignment="Right" Margin="0,0,5,0" >
                        <TextBlock x:Name="TxtNetMax" Text="100K" FontSize="10" VerticalAlignment="Top"/>
                        <TextBlock x:Name="TxtNetMid" Text="50K" FontSize="10" VerticalAlignment="Center" Margin="0,20,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" BorderBrush="#555" BorderThickness="0,0,0,1">
                        <Canvas x:Name="NetChartCanvas" ClipToBounds="True"/>
                    </Border>
                </Grid>

                <DataGrid Grid.Row="8" x:Name="DiskGrid" AutoGenerateColumns="False" HeadersVisibility="Column" Margin="0,5,0,0" Background="Transparent" RowHeaderWidth="0" GridLinesVisibility="None" BorderThickness="0" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="挂载点" Binding="{Binding Path}" Width="*"/>
                        <DataGridTextColumn Header="可用" Binding="{Binding Avail}" Width="*"/>
                        <DataGridTextColumn Header="大小" Binding="{Binding Size}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <GridSplitter HorizontalAlignment="Left" Background="Transparent" RenderTransformOrigin="0.5,0.5" Width="0" Grid.Column="2">
                <GridSplitter.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="1"/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </GridSplitter.RenderTransform>
            </GridSplitter>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.5*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TabControl Grid.Row="0" BorderThickness="0" Background="#1E3047">
                    <TabItem Header="🐧 服务器" IsSelected="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <term:TerminalControl x:Name="Terminal" Grid.Row="0" Margin="10" Focusable="True" Loaded="Terminal_Loaded" PreviewKeyDown="Terminal_PreviewKeyDown" KeyboardNavigation.DirectionalNavigation="None" KeyboardNavigation.TabNavigation="None" KeyboardNavigation.ControlTabNavigation="None" />
                            
                        </Grid>
                    </TabItem>
                    <TabItem Header="+"/>
                </TabControl>

                <GridSplitter Grid.Row="1" Height="3" HorizontalAlignment="Stretch" Background="Transparent" VerticalAlignment="Center"/>

                <TabControl Grid.Row="2" BorderThickness="0" Background="Transparent">
                    <TabItem Header="文件" IsSelected="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="129*"/>
                                <ColumnDefinition Width="409*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Height="35" Background="Transparent" Padding="5" Grid.ColumnSpan="2">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="BtnBack" Content="⬅️" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Click="BtnBack_Click" Foreground="White" />
                                        <Button x:Name="BtnForward" Content="➡️" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Click="BtnForward_Click" Foreground="White" />
                                        <Button x:Name="BtnRefresh" Content="🔄" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Click="BtnRefresh_Click" Foreground="White" />
                                        <Button x:Name="BtnUp" Content="⬆️" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Click="BtnUp_Click" Foreground="White" />
                                        <Button x:Name="BtnNewFolder" Content="📁" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Margin="0,0,10,0" Click="BtnNewFolder_Click" Foreground="White" />
                                        <TextBlock x:Name="TxtCurrentPath" Text="/root" VerticalAlignment="Center"  Foreground="White" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" >
                                        <TextBlock Text="历史 🔄 ⬆️" VerticalAlignment="Center"   />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <DataGrid x:Name="FileGrid" Grid.Row="1" AutoGenerateColumns="False" HeadersVisibility="Column" Background="Transparent" RowHeaderWidth="0" GridLinesVisibility="None" BorderThickness="0" Grid.ColumnSpan="2" MouseDoubleClick="FileGrid_MouseDoubleClick" IsReadOnly="True" SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="文件名" Width="2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Icon}" Margin="0,0,5,0"/>
                                                    <TextBlock Text="{Binding Name}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="大小" Binding="{Binding Size}" Width="*"/>
                                    <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="*"/>
                                    <DataGridTextColumn Header="修改时间" Binding="{Binding Date}" Width="1.5*"/>
                                    <DataGridTextColumn Header="权限" Binding="{Binding Perms}" Width="*"/>
                                    <DataGridTextColumn Header="用户/用户组" Binding="{Binding Owner}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="命令"/>
                </TabControl>
            </Grid>
        </Grid>
    </DockPanel>
</mica:MicaWindow>
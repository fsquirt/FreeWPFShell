<mica:MicaWindow x:Class="FreeWPFShell.UserForm.KeyManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mica="clr-namespace:MicaWPF.Controls;assembly=MicaWPF"
        xmlns:local="clr-namespace:FreeWPFShell.UserForm"
        xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="SSH 密钥管理" Height="500" Width="550"
        WindowStartupLocation="CenterOwner"
        SystemBackdropType="Acrylic" FontFamily="Microsoft YaHei" FontSize="14"
        ResizeMode="CanResize" MinHeight="350" MinWidth="400">

    <mica:MicaWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </mica:MicaWindow.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="已导入的 SSH 密钥" FontSize="16" VerticalAlignment="Center"/>
            <mica:Button HorizontalAlignment="Right" Padding="10,4" Click="BtnImport_Click">
                <StackPanel Orientation="Horizontal">
                    <icon:PackIconRemixIcon Kind="DownloadCloud2Line" Foreground="#00BCFF" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="导入密钥" VerticalAlignment="Center"/>
                </StackPanel>
            </mica:Button>
        </Grid>

        <!-- 密钥列表 -->
        <DataGrid Grid.Row="1" x:Name="KeyGrid" AutoGenerateColumns="False"
                  HeadersVisibility="Column" Background="Transparent"
                  RowHeaderWidth="0" GridLinesVisibility="None" BorderThickness="0"
                  IsReadOnly="True" SelectionMode="Single">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="删除密钥" Click="CtxDelete_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="1.5*"/>
                <DataGridTextColumn Header="指纹" Binding="{Binding Fingerprint}" Width="*"/>
                <DataGridTemplateColumn Width="40">
                    <DataGridTemplateColumn.Header>
                        <icon:PackIconRemixIcon Kind="LockPasswordLine" Width="14" Height="14" HorizontalAlignment="Center"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <icon:PackIconRemixIcon Kind="LockPasswordLine" Foreground="#00BCFF" Width="14" Height="14" HorizontalAlignment="Center"
                                                   Visibility="{Binding HasPassphrase, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="导入时间" Binding="{Binding ImportedAt, StringFormat=yyyy/MM/dd}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 底部说明 -->
        <TextBlock Grid.Row="2" Text="💡 密钥内容保存在本地，密钥密码被加密保护。务必使用加密的密钥，因为程序不会加密密钥本体！"
                   FontSize="11" Foreground="#78909C" Margin="0,10,0,0" TextWrapping="Wrap"/>
    </Grid>
</mica:MicaWindow>

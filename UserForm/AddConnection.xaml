<mica:MicaWindow x:Class="FreeWPFShell.UserForm.AddConnection"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FreeWPFShell.UserForm"
        xmlns:mica="clr-namespace:MicaWPF.Controls;assembly=MicaWPF"
        xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        Title="新建连接" Height="700" Width="600"
        WindowStartupLocation="CenterOwner"
        SystemBackdropType="Acrylic" FontFamily="Microsoft YaHei" FontSize="16" >
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 连接信息区域 -->

        <StackPanel Margin="5" Grid.Row="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="备注名:" VerticalAlignment="Center" Margin="0,5"/>
                <mica:TextBox Grid.Column="1" x:Name="txtHostName" Margin="5"/>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="主机IP:" VerticalAlignment="Center" Margin="0,5"/>
                <mica:TextBox Grid.Column="1" x:Name="txtHost" Margin="5"/>
                <TextBlock Grid.Column="2" Text="端口:" VerticalAlignment="Center" Margin="5,0"/>
                <mica:TextBox Grid.Column="3" x:Name="txtPort" Text="22" Margin="0,5"/>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="用户名:" VerticalAlignment="Center" Margin="0,5"/>
                <mica:TextBox Grid.Column="1" Text="root" x:Name="txtUsername" Margin="5"/>
            </Grid>
        </StackPanel>

        <!-- 认证方式区域 -->
        <StackPanel Grid.Row="1" Margin="5">
            <mica:ToggleSwitch x:Name="rbPassword" Content="密码登录" IsChecked="True" Margin="0,5" Checked="rbPassword_Checked"/>
            <StackPanel x:Name="pnlPassword" Margin="20,0,0,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="17.982"/>
                        <ColumnDefinition Width="62.018"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="密码:" VerticalAlignment="Center" Grid.ColumnSpan="2"/>
                    <mica:TextBox Grid.Column="2" x:Name="txtPassword" Margin="0,3,0,3"/>
                </Grid>
            </StackPanel>
            <mica:ToggleSwitch x:Name="rbKey" Content="密钥登录" Margin="0,5" Checked="rbKey_Checked"/>
            <StackPanel x:Name="pnlKey" Margin="20,0,0,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="cmbKeySelect" Margin="0,3" Height="30"
                              DisplayMemberPath="DisplayText" SelectedValuePath="Id"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <icon:PackIconRemixIcon Kind="InformationLine" Foreground="#78909C" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="请先在主界面的「密钥管理」中导入密钥" FontSize="11" Foreground="#78909C" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- 代理设置区域 -->

        <StackPanel Grid.Row="2" Margin="5">
            <mica:ToggleSwitch x:Name="chkProxy" Content="启用代理" Margin="0,5" IsChecked="False" Checked="chkProxy_Checked" Unchecked="chkProxy_Checked"/>
            <StackPanel x:Name="pnlProxy" IsEnabled="False">
                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto" MinWidth="40"/>
                        <ColumnDefinition Width="63"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="类型:" VerticalAlignment="Center" Height="20"/>
                    <ComboBox Grid.Column="1" x:Name="cmbProxyType" Margin="5,0,0,0" SelectedIndex="0" Height="30">
                        <ComboBoxItem Content="HTTP"/>
                        <ComboBoxItem Content="SOCKS4"/>
                        <ComboBoxItem Content="SOCKS5"/>
                    </ComboBox>
                    <TextBlock Grid.Column="2" Text="端口:" VerticalAlignment="Center" Margin="5,0,5,0" Height="20"/>
                    <mica:TextBox Grid.Column="3" x:Name="txtProxyPort" Text="10808" Margin="0,3,0,3"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="代理IP:" VerticalAlignment="Center"/>
                    <mica:TextBox Grid.Column="1" x:Name="txtProxyHost" Margin="5,3"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="用户名:" VerticalAlignment="Center"/>
                    <mica:TextBox Grid.Column="1" x:Name="txtProxyUsername" Margin="5,3"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="密码:" VerticalAlignment="Center"/>
                    <mica:TextBox Grid.Column="1" x:Name="txtProxyPassword" Margin="5,3"/>
                </Grid>
            </StackPanel>
        </StackPanel>

        <!-- 按钮 -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <mica:Button x:Name="BtnTestProxy" Width="100" Margin="0,0,10,0" Padding="5" Click="BtnTestProxy_Click">
                <StackPanel Orientation="Horizontal">
                    <icon:PackIconRemixIcon x:Name="IconTestProxy" Kind="PlugLine" Foreground="#00BCFF" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock x:Name="TxtTestProxy" Text="测试代理" VerticalAlignment="Center"/>
                </StackPanel>
            </mica:Button>
            <mica:Button x:Name="BtnSave" Content="保存配置" Width="80" Margin="0,0,10,0" Padding="5" Click="BtnSave_Click"/>
            <mica:Button x:Name="BtnConnect" Content="保存并连接" Width="90" Padding="5" Click="BtnConnect_Click"/>
        </StackPanel>
    </Grid>

</mica:MicaWindow>

<mica:MicaWindow x:Class="FreeWPFShell.UserForm.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mica="clr-namespace:MicaWPF.Controls;assembly=MicaWPF"
        Title="重命名" Height="180" Width="350"
        SystemBackdropType="Acrylic"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Topmost="True">
    
    <Border>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="60" />
            </Grid.RowDefinitions>
            
            <mica:TextBox x:Name="TxtNewName" Grid.Row="0" Margin="20,15,20,10" VerticalAlignment="Center" Padding="5" FontSize="14" Background="Transparent"/>
            
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0">
                <mica:Button Content="取消" Width="80" Height="30" Margin="0,0,10,0" Click="BtnCancel_Click"/>
                <mica:Button Content="确定" Width="80" Height="30" Click="BtnConfirm_Click" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Border>
</mica:MicaWindow>
